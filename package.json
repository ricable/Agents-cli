{
  "name": "agents-cli",
  "version": "0.1.0",
  "description": "CLI tool for discovering, installing, and managing agent tools",
  "type": "module",
  "bin": {
    "agents-cli": "./dist/bin/agents-cli.js",
    "agent-run": "./dist/bin/agent-run.js"
  },
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/lib/index.js",
      "types": "./dist/lib/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "agents",
    "cli",
    "tools",
    "mcp"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "@vitest/coverage-v8": "^1.6.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "zod": "^3.23.0"
  }
}
