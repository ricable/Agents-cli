#!/usr/bin/env python3
# /// script
# requires-python = ">=3.10"
# dependencies = ["Pillow>=10.0.0"]
# ///
"""cli-anything-gimp — CLI wrapper for GIMP image operations with JSON output.

Provides subcommands for image resizing, format conversion, filtering,
metadata inspection, batch processing, and project management.
Works with Pillow for real image ops; prints structured help without it.
"""
import argparse
import json
import os
import sys

__version__ = "0.1.0"

try:
    from PIL import Image, ImageFilter
    HAS_PILLOW = True
except ImportError:
    HAS_PILLOW = False


def _json_out(data: dict) -> None:
    json.dump(data, sys.stdout, indent=2)
    sys.stdout.write("\n")


def _error(msg: str, as_json: bool = False) -> None:
    if as_json:
        _json_out({"ok": False, "error": msg})
    else:
        print(f"Error: {msg}", file=sys.stderr)
    sys.exit(1)


# ── project subcommand ────────────────────────────────────────────────

def cmd_project(args: argparse.Namespace) -> None:
    action = args.action
    if action == "list":
        projects = [".gimp-project.json"] if os.path.exists(".gimp-project.json") else []
        if args.json:
            _json_out({"ok": True, "command": "project list", "data": {"projects": projects}})
        else:
            print(f"Projects found: {len(projects)}")
            for p in projects:
                print(f"  {p}")
    elif action == "new":
        name = args.name or "untitled"
        meta = {"name": name, "version": "1.0", "files": []}
        if args.json:
            _json_out({"ok": True, "command": "project new", "data": meta})
        else:
            print(f"Created project: {name}")
    elif action == "open":
        path = args.path or ".gimp-project.json"
        if args.json:
            _json_out({"ok": True, "command": "project open", "data": {"path": path}})
        else:
            print(f"Opened project: {path}")
    elif action == "save":
        if args.json:
            _json_out({"ok": True, "command": "project save", "data": {"saved": True}})
        else:
            print("Project saved.")


# ── resize subcommand ─────────────────────────────────────────────────

def cmd_resize(args: argparse.Namespace) -> None:
    if not args.input:
        _error("--input is required", args.json)
    if not HAS_PILLOW:
        _error("Pillow is required for resize. Install with: uv pip install Pillow", args.json)

    img = Image.open(args.input)
    orig_w, orig_h = img.size
    new_w = args.width or orig_w
    new_h = args.height or orig_h
    resized = img.resize((new_w, new_h), Image.LANCZOS)
    out = args.output or args.input
    resized.save(out)
    result = {"input": args.input, "output": out, "original": [orig_w, orig_h], "resized": [new_w, new_h]}
    if args.json:
        _json_out({"ok": True, "command": "resize", "data": result})
    else:
        print(f"Resized {args.input} ({orig_w}x{orig_h}) -> {out} ({new_w}x{new_h})")


# ── convert subcommand ────────────────────────────────────────────────

def cmd_convert(args: argparse.Namespace) -> None:
    if not args.input:
        _error("--input is required", args.json)
    if not HAS_PILLOW:
        _error("Pillow is required for convert. Install with: uv pip install Pillow", args.json)

    img = Image.open(args.input)
    fmt = (args.format or "png").upper()
    if fmt == "JPG":
        fmt = "JPEG"
    out = args.output or f"{os.path.splitext(args.input)[0]}.{args.format or 'png'}"
    save_kwargs = {}
    if fmt == "JPEG" and args.quality:
        save_kwargs["quality"] = args.quality
    if img.mode == "RGBA" and fmt == "JPEG":
        img = img.convert("RGB")
    img.save(out, format=fmt, **save_kwargs)
    result = {"input": args.input, "output": out, "format": fmt}
    if args.json:
        _json_out({"ok": True, "command": "convert", "data": result})
    else:
        print(f"Converted {args.input} -> {out} ({fmt})")


# ── filter subcommand ─────────────────────────────────────────────────

FILTERS = {
    "blur": lambda s: ImageFilter.GaussianBlur(radius=s),
    "sharpen": lambda _: ImageFilter.SHARPEN,
    "grayscale": None,
    "invert": None,
    "edge-detect": lambda _: ImageFilter.FIND_EDGES,
}

def cmd_filter(args: argparse.Namespace) -> None:
    if not args.input:
        _error("--input is required", args.json)
    if not HAS_PILLOW:
        _error("Pillow is required for filter. Install with: uv pip install Pillow", args.json)
    if args.type not in FILTERS:
        _error(f"Unknown filter: {args.type}. Available: {', '.join(FILTERS)}", args.json)

    img = Image.open(args.input)
    strength = args.strength or 2.0

    if args.type == "grayscale":
        img = img.convert("L")
    elif args.type == "invert":
        from PIL import ImageOps
        if img.mode == "RGBA":
            img = img.convert("RGB")
        img = ImageOps.invert(img)
    else:
        filt = FILTERS[args.type](strength)
        img = img.filter(filt)

    out = args.output or args.input
    img.save(out)
    result = {"input": args.input, "output": out, "filter": args.type, "strength": strength}
    if args.json:
        _json_out({"ok": True, "command": "filter", "data": result})
    else:
        print(f"Applied {args.type} filter to {args.input} -> {out}")


# ── info subcommand ───────────────────────────────────────────────────

def cmd_info(args: argparse.Namespace) -> None:
    if not args.input:
        _error("--input is required", args.json)
    if not HAS_PILLOW:
        _error("Pillow is required for info. Install with: uv pip install Pillow", args.json)

    img = Image.open(args.input)
    w, h = img.size
    file_size = os.path.getsize(args.input)
    result = {
        "path": args.input,
        "width": w,
        "height": h,
        "format": img.format,
        "mode": img.mode,
        "size_bytes": file_size,
    }
    if args.json:
        _json_out({"ok": True, "command": "info", "data": result})
    else:
        print(f"File:       {args.input}")
        print(f"Dimensions: {w}x{h}")
        print(f"Format:     {img.format}")
        print(f"Mode:       {img.mode}")
        print(f"Size:       {file_size} bytes")


# ── batch subcommand ──────────────────────────────────────────────────

def cmd_batch(args: argparse.Namespace) -> None:
    if not args.input_dir:
        _error("--input-dir is required", args.json)
    if not HAS_PILLOW:
        _error("Pillow is required for batch. Install with: uv pip install Pillow", args.json)

    input_dir = args.input_dir
    output_dir = args.output_dir or input_dir
    os.makedirs(output_dir, exist_ok=True)
    exts = {".png", ".jpg", ".jpeg", ".gif", ".bmp", ".tiff", ".webp"}
    files = [f for f in os.listdir(input_dir)
             if os.path.splitext(f)[1].lower() in exts]

    processed = []
    for f in files:
        inp = os.path.join(input_dir, f)
        base = os.path.splitext(f)[0]
        fmt = (args.format or "png").lower()
        out = os.path.join(output_dir, f"{base}.{fmt}")
        img = Image.open(inp)
        if args.operation == "grayscale":
            img = img.convert("L")
        elif args.operation == "resize" and args.width and args.height:
            img = img.resize((args.width, args.height), Image.LANCZOS)
        out_fmt = fmt.upper()
        if out_fmt == "JPG":
            out_fmt = "JPEG"
        if img.mode == "RGBA" and out_fmt == "JPEG":
            img = img.convert("RGB")
        img.save(out, format=out_fmt)
        processed.append({"input": inp, "output": out})

    if args.json:
        _json_out({"ok": True, "command": "batch", "data": {"processed": len(processed), "files": processed}})
    else:
        print(f"Batch processed {len(processed)} files from {input_dir} -> {output_dir}")


# ── main ──────────────────────────────────────────────────────────────

def main() -> None:
    parser = argparse.ArgumentParser(
        prog="cli-anything-gimp",
        description="CLI wrapper for GIMP image editor — resize, convert, filter, batch process images with JSON output",
    )
    parser.add_argument("--version", action="version", version=f"cli-anything-gimp {__version__}")
    parser.add_argument("--json", action="store_true", help="Output structured JSON")
    parser.add_argument("--verbose", action="store_true", help="Enable verbose logging")

    subs = parser.add_subparsers(dest="command", help="Available commands")

    # project
    p_proj = subs.add_parser("project", help="GIMP project management")
    p_proj.add_argument("action", choices=["new", "open", "save", "list"], help="Project action")
    p_proj.add_argument("--name", help="Project name (for new)")
    p_proj.add_argument("--path", help="Project path (for open)")

    # resize
    p_resize = subs.add_parser("resize", help="Resize an image")
    p_resize.add_argument("--input", required=True, help="Input image path")
    p_resize.add_argument("--output", help="Output image path")
    p_resize.add_argument("--width", type=int, help="Target width in pixels")
    p_resize.add_argument("--height", type=int, help="Target height in pixels")

    # convert
    p_conv = subs.add_parser("convert", help="Convert image format")
    p_conv.add_argument("--input", required=True, help="Input image path")
    p_conv.add_argument("--output", help="Output image path")
    p_conv.add_argument("--format", choices=["png", "jpg", "gif", "bmp", "webp", "tiff"], help="Target format")
    p_conv.add_argument("--quality", type=int, help="JPEG quality (1-100)")

    # filter
    p_filt = subs.add_parser("filter", help="Apply image filter")
    p_filt.add_argument("--input", required=True, help="Input image path")
    p_filt.add_argument("--output", help="Output image path")
    p_filt.add_argument("--type", choices=["blur", "sharpen", "grayscale", "invert", "edge-detect"],
                        required=True, help="Filter type")
    p_filt.add_argument("--strength", type=float, help="Filter strength (where applicable)")

    # info
    p_info = subs.add_parser("info", help="Show image metadata")
    p_info.add_argument("--input", required=True, help="Input image path")

    # batch
    p_batch = subs.add_parser("batch", help="Batch process images in a directory")
    p_batch.add_argument("--input-dir", required=True, help="Input directory")
    p_batch.add_argument("--output-dir", help="Output directory")
    p_batch.add_argument("--operation", choices=["grayscale", "resize", "convert"], default="convert",
                         help="Batch operation")
    p_batch.add_argument("--format", help="Output format for conversion")
    p_batch.add_argument("--width", type=int, help="Width for resize operation")
    p_batch.add_argument("--height", type=int, help="Height for resize operation")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(0)

    handlers = {
        "project": cmd_project,
        "resize": cmd_resize,
        "convert": cmd_convert,
        "filter": cmd_filter,
        "info": cmd_info,
        "batch": cmd_batch,
    }
    handlers[args.command](args)


if __name__ == "__main__":
    main()
